# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# From `supabase status` once the local stack is running (npm run db:start),
# or from your cloud project's Settings -> API page if using hosted Supabase instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by Drizzle Kit for migrations.
# Local stack default (from `supabase status`): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
