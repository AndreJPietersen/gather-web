{
  "name": "@gather/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema (tables, RLS policies) and SQL migrations for Gather's Postgres database.",
  "exports": {
    "./schema": "./src/schema.ts",
    "./database.types": "./src/database.types.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:fingerprint": "node scripts/fingerprint.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed:reference": "node scripts/seed.mjs reference",
    "db:seed:demo": "node scripts/seed.mjs demo",
    "db:types": "node scripts/gen-types.mjs",
    "db:types:check": "node scripts/gen-types.mjs --check"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "@types/node": "^20"
  }
}
