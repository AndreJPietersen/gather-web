{
  "name": "gather",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gather/web",
    "dev:mobile": "npm run dev:mobile -w @gather/web",
    "build": "turbo run build --filter=@gather/web",
    "start": "npm run start -w @gather/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint e2e packages playwright.config.ts",
    "test": "turbo run test",
    "test:watch": "npm run test:watch -w @gather/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "npm run db:generate -w @gather/db",
    "db:migrate": "npm run db:migrate -w @gather/db",
    "db:push": "echo 'DO NOT USE — drizzle-kit push silently drops RLS policy conditions, see docs/gather_web_architecture.md. Use db:generate then db:migrate instead.' && exit 1",
    "db:studio": "npm run db:studio -w @gather/db",
    "e2e": "playwright test",
    "e2e:security": "playwright test -g security",
    "db:migrate:status": "npm run db:migrate:status -w @gather/db",
    "db:fingerprint": "npm run db:fingerprint -w @gather/db --",
    "db:seed:reference": "npm run db:seed:reference -w @gather/db",
    "db:seed:demo": "npm run db:seed:demo -w @gather/db",
    "auth-emails": "tsx scripts/generate-auth-emails.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.116.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postgres": "^3.4.9",
    "supabase": "^2.117.0",
    "turbo": "^2.11.4",
    "typescript": "^5"
  }
}
