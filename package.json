{
  "name": "gather",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gather/web",
    "dev:mobile": "npm run dev:mobile -w @gather/web",
    "build": "npm run build -w @gather/web",
    "start": "npm run start -w @gather/web",
    "typecheck": "npm run typecheck -w @gather/web",
    "lint": "npm run lint -w @gather/web && eslint e2e playwright.config.ts",
    "test": "npm run test -w @gather/web",
    "test:watch": "npm run test:watch -w @gather/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "npm run db:generate -w @gather/web",
    "db:migrate": "npm run db:migrate -w @gather/web",
    "db:push": "echo 'DO NOT USE — drizzle-kit push silently drops RLS policy conditions, see docs/gather_web_architecture.md. Use db:generate then db:migrate instead.' && exit 1",
    "db:studio": "npm run db:studio -w @gather/web",
    "e2e": "playwright test",
    "e2e:security": "playwright test -g security"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.116.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postgres": "^3.4.9",
    "supabase": "^2.117.0",
    "typescript": "^5"
  }
}
